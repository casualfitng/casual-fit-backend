# Postgres — on Render, link the database or paste Internal Database URL on the web service
DATABASE_URL=postgresql://user:pass@localhost:5432/casual_fit

# Required in production (Render: generate a long random string)
ACCESS_TOKEN_SECRET=replace-with-a-long-random-string

# Render sets PORT automatically; use 4000 locally
PORT=4000

# Optional: promote this email to admin on startup (after migrations + seed)
ADMIN_EMAIL=

# Comma-separated Google OAuth client IDs (iOS + web) for ID token verification
GOOGLE_CLIENT_IDS=

APPLE_BUNDLE_ID=com.casualfit.app

# Browser clients only (admin / Expo web). Comma-separated. Native mobile does not use CORS.
# Example: https://your-admin.onrender.com,https://casualfit.ng
CORS_ORIGINS=
